rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidTask(data) {
      return data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.status in ['todo', 'inprogress', 'done']
        && data.priority in ['low', 'medium', 'high']
        && data.assignee is string
        && data.due is string;
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidTask(request.resource.data);
      allow update: if isSignedIn() && isValidTask(request.resource.data);
      allow delete: if isSignedIn();
    }

    match /activity/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
